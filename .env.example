# Jangan commit API key asli.
GEMINI_API_KEY=
# Maksimal 100 key, pisahkan dengan koma.
GEMINI_API_KEYS=
# Opsional. Hanya tiga model berikut yang diterima:
# gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-2.5-flash-lite
# Jika kosong, urutan default dimulai dari gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
